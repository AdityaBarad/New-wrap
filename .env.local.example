# Copy this file to .env.local and fill in your Supabase project values.
# Do NOT commit .env.local to version control.
# Find the values at: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-side (non-public) service_role key (keep secret, use only on server)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI — powers personalized wrap content generation
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token
